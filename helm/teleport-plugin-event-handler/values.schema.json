{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "eventHandler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "batch": {
                    "type": "integer",
                    "description": "Maximum number of events fetched from Teleport in one request"
                },
                "storagePath": {
                    "type": "string",
                    "description": "Path to the directory where event-handler's state is stored"
                },
                "timeout": {
                    "type": "string",
                    "description": "Maximum time to wait for incoming events before sending them to fluentd."
                }
            }
        },
        "fluentd": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "certificate": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "caPath": {
                            "type": "string",
                            "description": "Path of the CA certificate in the secret described by fluentd.certificate.secretName."
                        },
                        "certPath": {
                            "type": "string",
                            "description": "Path of the client's certificate in the secret described by fluentd.certificate.secretName."
                        },
                        "keyPath": {
                            "type": "string",
                            "description": "Path of the client private key in the secret described by fluentd.certificate.secretName."
                        },
                        "secretName": {
                            "type": "string",
                            "description": "Name of the secret where credentials for the connection is stored. It must contain the client's private key, certificate and fluentd's CA certificate. See the default paths below."
                        }
                    }
                },
                "sessionUrl": {
                    "type": "string",
                    "description": "URL of fluentd where the session logs will be sent to."
                },
                "url": {
                    "type": "string",
                    "description": "URL of fluentd where the event logs will be sent to."
                }
            }
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "persistentVolumeClaim": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Instructs the Helm chart to include a PersistentVolumeClaim for the storage. This storage will be mounted to the path specified by eventHandler.storagePath."
                },
                "existingClaim": {
                    "type": "string",
                    "description": "Specifies an already existing PersistentVolumeClaim which should be mounted to the path specified by eventHandler.storagePath. persistentVolumeClaim.enabled must be set to false for this option to take precedence. Ignored when persistentVolumeClaim.enabled is true."
                },
                "size": {
                    "type": "string",
                    "description": "Sets the size of the created PersistentVolumeClaim. Don't forget to append the proper suffix!"
                },
                "storageClassName": {
                    "type": "string",
                    "description": "Sets the storage class name of the created PersistentVolumeClaim. Kubernetes will use the default one when omitted."
                },
                "volumeName": {
                    "type": "string"
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "additionalProperties": false
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false
        },
        "provider": {
            "type": "string"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "teleport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "address": {
                    "type": "string",
                    "description": "Host/port combination of the teleport auth server"
                },
                "identitySecretName": {
                    "type": "string",
                    "description": "Name of the Kubernetes secret that contains the credentials for the connection"
                },
                "identitySecretPath": {
                    "type": "string",
                    "description": "Key of the field in the secret specified by teleport.identitySecretName"
                }
            }
        },
        "tolerations": {
            "type": "array"
        },
        "volumeMounts": {
            "type": "array"
        },
        "volumes": {
            "type": "array"
        }
    }
}
